# settlin-validator — copy to .env and fill in. This host is operated by an INDEPENDENT party.
# The relayer never sees VALIDATOR_KEY.

# This validator's OWN signing key. Generate it on THIS host; register the address on-chain via
# Governance DeliveryAttestor.setValidator(addr,true). Keep it only here.
VALIDATOR_KEY=0xYOUR_OWN_VALIDATOR_PRIVATE_KEY

# The DeliveryAttestor to read authoritative digests from (Ethereum mainnet).
DELIVERY_ATTESTOR_ADDRESS=0x3Fb200cFbD2965B72A6210783B0d66051A222CfD

# YOUR OWN RPCs (not the relayer's) — independence means independent nodes.
ATTESTOR_RPC=https://your-own-ethereum-rpc
SOLANA_RPC=https://your-own-solana-rpc
# EVM_RPC_ETHEREUM=...   # optional, for native-ETH payouts
# EVM_RPC_ARBITRUM=...

HOST=0.0.0.0
PORT=8800

# Bearer token the relayer must present on /attest. Coarse anti-spam only. Long random value.
VALIDATOR_AUTH_TOKEN=change-me-to-a-long-random-string
